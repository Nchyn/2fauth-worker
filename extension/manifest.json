{
  "manifest_version": 3,
  "name": "2FAuth Worker 验证码",
  "short_name": "2FAuth Worker",
  "version": "1.3.0",
  "description": "使用 2fauth-worker 的设备令牌或登录会话，在工具栏和 OTP 输入框旁快速查看、填入 TOTP 验证码。",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "clipboardWrite",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "2FAuth Worker 验证码",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "2fauth-worker-extension@local",
      "strict_min_version": "121.0"
    }
  }
}
